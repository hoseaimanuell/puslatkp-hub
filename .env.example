# Dipakai oleh docker-compose.yml (salin menjadi .env). Untuk menjalankan tanpa Docker
# gunakan be/.env dan fe/.env.local (lihat docs/02-instalasi-dan-menjalankan.md).

# --- Keamanan (WAJIB): string acak >= 16 karakter ---
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Database MySQL (phpMyAdmin / Laragon di komputer host) ---
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Puslatkp1a

# --- Jaringan ---
# Origin frontend yang boleh memanggil API (pisahkan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:3000
# URL API yang dipakai BROWSER; ditanam saat build fe (ganti ke domain Anda di produksi)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FE_PORT=3000
BE_PORT=4000
