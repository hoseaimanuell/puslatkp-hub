# ===== Backend (Express) =====
PORT=4000
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:3000
# Wajib diisi, minimal 16 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Lama (hari) data yang dihapus disimpan di Tempat Sampah sebelum dibuang permanen
# Folder berkas Arsip Historis (default: be/storage). WAJIB ikut di-backup.
# STORAGE_DIR=
TRASH_RETENTION_DAYS=30

# ===== Database MySQL (phpMyAdmin / Laragon) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# DB_SSL=true   # wajib untuk database cloud (Aiven, dll.)
DB_NAME=Puslatkp1a
