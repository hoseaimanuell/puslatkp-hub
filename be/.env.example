# ===== Backend (Express) =====
PORT=4000
# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:3000
# Jumlah proxy di depan backend (untuk membaca IP asli pengunjung). Bawaan: loopback (Nginx/fe di server yang sama).
# Hosting dengan load balancer di depan (mis. Render satu layanan): TRUST_PROXY=2
# TRUST_PROXY=loopback
# Wajib diisi, minimal 16 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Lama (hari) data yang dihapus disimpan di Tempat Sampah sebelum dibuang permanen
# Folder berkas Arsip Historis & kolom bertipe Berkas (default: be/storage). WAJIB ikut di-backup.
# STORAGE_DIR=
TRASH_RETENTION_DAYS=30

# ===== Database MySQL (phpMyAdmin / Laragon) =====
DB_HOST=127.0.0.1
DB_PORT=3306
# Produksi: JANGAN pakai root — buat user khusus dengan database/buat_user_aplikasi.sql
DB_USER=root
DB_PASSWORD=
# DB_SSL=true   # wajib untuk database cloud (Aiven, dll.)
# DB_SSL_CA=/path/ca.pem   # sertifikat CA dari penyedia database: koneksi SSL ikut diverifikasi (disarankan)
DB_NAME=Puslatkp1a

# ===== Backup (npm run backup) =====
# BACKUP_DIR=          # bawaan: <repo>/backup — sebaiknya drive/NAS lain
# BACKUP_KEEP_DAYS=14
# MYSQLDUMP_PATH=      # bila mysqldump tidak ada di PATH (Laragon terdeteksi otomatis)
